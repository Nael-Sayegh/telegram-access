# Certificats et profils chiffrés dans un second dépôt privé.
# Déchiffrement : MATCH_PASSWORD ; accès git : MATCH_GIT_BASIC_AUTHORIZATION
# (base64 de "utilisateur:jeton", jeton en lecture seule pour les builds).
git_url("https://github.com/Nael-Sayegh/telegram-access-certs.git")
storage_mode("git")
type("appstore")
app_identifier(["com.nael.telegramaccess"])
team_id(ENV["APPLE_TEAM_ID"]) if ENV["APPLE_TEAM_ID"]
