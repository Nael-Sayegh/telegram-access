default_platform(:ios)

APP_ID = "com.nael.telegramaccess"
PROJECT = "TelegramAccess.xcodeproj"
SCHEME = "TelegramAccess"
APP_TARGET = "TelegramAccess"
SPM_DIR = "SourcePackages"
SIMULATOR = "iPhone 17"

platform :ios do
  desc "Tests sur simulateur. UI_TESTS=1 ajoute les tests UI (audits d'accessibilité)."
  lane :test do
    with_ui = ENV["UI_TESTS"] == "1"
    scan(
      project: PROJECT,
      scheme: with_ui ? SCHEME : "TelegramAccessUnit",
      device: SIMULATOR,
      cloned_source_packages_path: SPM_DIR,
      code_coverage: true,
      result_bundle: true,
      output_directory: "build/test_output",
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Génération initiale des certificats et profils (workflow manuel certs-init)."
  lane :certs_init do
    setup_ci
    api_key = asc_api_key
    match(type: "appstore", readonly: false, api_key: api_key)
  end

  desc "Archive signée puis envoi sur TestFlight."
  lane :beta do
    setup_ci
    api_key = asc_api_key
    match(type: "appstore", readonly: true, api_key: api_key)

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      targets: [APP_TARGET],
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("sigh_#{APP_ID}_appstore_profile-name")
    )

    build_number = ENV.fetch("BUILD_NUMBER", "1")
    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      cloned_source_packages_path: SPM_DIR,
      output_directory: "build",
      include_symbols: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
